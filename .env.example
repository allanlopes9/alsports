# Desenvolvimento
DB_DEV_URL=jdbc:postgresql://localhost:5432/alsports_dev
DB_DEV_USERNAME=alsports_app
DB_DEV_PASSWORD=COLOQUE_A_SENHA_DO_USUARIO_AQUI

# Testes
DB_TEST_URL=jdbc:postgresql://localhost:5432/alsports_test
DB_TEST_USERNAME=alsports_app
DB_TEST_PASSWORD=COLOQUE_A_SENHA_DO_USUARIO_AQUI

# Produção
DB_URL=jdbc:postgresql://servidor:5432/banco
DB_USERNAME=usuario_da_aplicacao
DB_PASSWORD=COLOQUE_O_SEGREDO_DA_PLATAFORMA_AQUI

# JWT / OAuth2 Resource Server
# Gere uma chave Base64 aleatória com pelo menos 32 bytes decodificados.
# Windows PowerShell:
#   $bytes = New-Object byte[] 32
#   $rng = [Security.Cryptography.RNGCryptoServiceProvider]::Create()
#   $rng.GetBytes($bytes)
#   $rng.Dispose()
#   [Convert]::ToBase64String($bytes)
# O valor abaixo é apenas um placeholder fictício e não funciona como chave.
JWT_SECRET=substitua-por-uma-chave-base64-de-256-bits

# Refresh token (nao sao segredos: apenas duracoes da familia de sessao)
REFRESH_TOKEN_IDLE_TIMEOUT=PT30M
REFRESH_TOKEN_ABSOLUTE_EXPIRATION=PT8H

# Protecao da autenticacao (nao sao segredos: limites e duracoes)
# 5 falhas em 15 minutos bloqueiam o login por 15 minutos.
AUTHENTICATION_MAX_FAILED_ATTEMPTS=5
AUTHENTICATION_FAILURE_WINDOW=PT15M
AUTHENTICATION_LOCK_DURATION=PT15M

# Administrador inicial
# Use apenas na primeira execução de um banco vazio e desative em seguida.
# Todos os campos são obrigatórios quando INITIAL_ADMIN_ENABLED=true.
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_NAME=Administrador Local
INITIAL_ADMIN_EMAIL=administrador@example.com
INITIAL_ADMIN_CPF=52998224725
INITIAL_ADMIN_LOGIN=administrador
INITIAL_ADMIN_PASSWORD=COLOQUE_UMA_SENHA_LOCAL_FORTE_AQUI